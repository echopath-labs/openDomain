{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendomain.dev/schemas/grounding-pack.schema.json",
  "title": "OpenDomain Grounding Pack v1",
  "type": "object",
  "required": [
    "protocol_version",
    "grounding_request",
    "read_first",
    "candidate_boundaries",
    "context_budget",
    "errors",
    "warnings"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "grounding_request": {
      "oneOf": [
        { "$ref": "grounding-request.schema.json" },
        { "type": "null" }
      ]
    },
    "read_first": {
      "type": "array",
      "items": { "$ref": "#/$defs/readFirst" }
    },
    "candidate_boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateBoundary" }
    },
    "context_budget": {
      "$ref": "#/$defs/contextBudget"
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/errorDiagnostic" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warningDiagnostic" }
    }
  },
  "$defs": {
    "readFirst": {
      "type": "object",
      "required": ["id", "type", "status", "file"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "bounded_context",
            "domain_concept",
            "business_rule",
            "lifecycle",
            "domain_event"
          ]
        },
        "name": { "type": "string" },
        "status": { "const": "accepted" },
        "file": { "$ref": "#/$defs/repositoryPath" },
        "context": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "bounded_context" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "id": { "pattern": "^[a-z][a-z0-9_-]*$" }
            }
          },
          "else": {
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_-]*)+$"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "candidateBoundary": {
      "type": "object",
      "required": ["id", "status", "target_id", "confidence", "file"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{4}(-[a-z0-9]+)*$"
        },
        "status": {
          "enum": ["proposed", "rejected", "superseded", "deprecated"]
        },
        "target_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "file": { "$ref": "#/$defs/repositoryPath" }
      },
      "additionalProperties": true
    },
    "sourceEstimate": {
      "type": "object",
      "required": ["source_count", "estimated_tokens"],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "contextBudget": {
      "type": "object",
      "required": [
        "estimator",
        "advisory",
        "required",
        "optional_candidates",
        "total_possible_estimated_tokens"
      ],
      "properties": {
        "estimator": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "chars-div-4" },
            "version": { "const": "1" }
          },
          "additionalProperties": false
        },
        "advisory": { "const": true },
        "required": { "$ref": "#/$defs/sourceEstimate" },
        "optional_candidates": { "$ref": "#/$defs/sourceEstimate" },
        "total_possible_estimated_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "file", "field", "problem", "fix"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "file": { "$ref": "#/$defs/safePath" },
        "field": { "$ref": "#/$defs/safeLine" },
        "problem": { "$ref": "#/$defs/safeLine" },
        "fix": { "$ref": "#/$defs/safeLine" }
      },
      "additionalProperties": true
    },
    "errorDiagnostic": {
      "allOf": [
        { "$ref": "#/$defs/diagnostic" },
        {
          "properties": {
            "severity": { "const": "error" }
          }
        }
      ]
    },
    "warningDiagnostic": {
      "allOf": [
        { "$ref": "#/$defs/diagnostic" },
        {
          "properties": {
            "severity": { "const": "warning" }
          }
        }
      ]
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])\\S(?:.*\\S)?$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2}(?:/|$)|//))(?!.*[\\u0000-\\u001F\\u007F])(?!.*[/]$)\\S(?:.*\\S)?$"
    },
    "safeLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    }
  },
  "additionalProperties": true
}
