{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendomain.dev/schemas/grounding-request.schema.json",
  "title": "OpenDomain Grounding Request v1",
  "type": "object",
  "required": ["protocol_version", "source", "intent", "affects_domain"],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "grounding": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["required", "not_required", "unclassified"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "not_required" }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["rationale"]
          }
        }
      ],
      "additionalProperties": false
    },
    "affects_domain": {
      "type": "object",
      "required": ["concepts", "rules", "lifecycles", "events"],
      "properties": {
        "concepts": { "$ref": "#/$defs/idArray" },
        "rules": { "$ref": "#/$defs/idArray" },
        "lifecycles": { "$ref": "#/$defs/idArray" },
        "events": { "$ref": "#/$defs/idArray" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grounding": {
            "properties": {
              "status": { "const": "not_required" }
            },
            "required": ["status"]
          }
        },
        "required": ["grounding"]
      },
      "then": {
        "properties": {
          "affects_domain": {
            "properties": {
              "concepts": { "maxItems": 0 },
              "rules": { "maxItems": 0 },
              "lifecycles": { "maxItems": 0 },
              "events": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "idArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
